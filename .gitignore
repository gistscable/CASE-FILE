# Local runtime / tooling (not part of the app)
.venv/
.venv-*/
__pycache__/
*.pyc
node_modules/
.pytest_cache/

# Local scratch output
*.log.tmp
.DS_Store

# Local runtime for the sandbox dev server (not part of the app)
.casefile-studio-local/
.tools/

# Server data that is deliberately not versioned:
# - media/: uploaded source files (originals live with the producer; too large
#   for git — rendered outputs are committed under data/exports/ instead)
# - browser-sessions/: browser-side recovery snapshots, machine-local
# - recovery-backups/: transient pre-repair safety copies
casefile-studio/data/media/
casefile-studio/data/browser-sessions/
casefile-studio/data/recovery-backups/

# Downloaded third-party guide sources (see
# casefile-studio/examples/the-last-timeline/sources/README.md):
# a manifest is committed, the video files themselves are not.
casefile-studio/examples/the-last-timeline/sources/downloads/
